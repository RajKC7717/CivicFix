# ---------------------------------------------------------------------------
# NagarNetra configuration. Copy to .env and edit. NEVER commit a real .env.
#
# The defaults below are a complete, working, fully offline configuration.
# You do not need an API key, a network connection or a GPU to run the demo.
# ---------------------------------------------------------------------------

# --- AI provider ------------------------------------------------------------
# none      -> offline classifier only. Everything works. This is the default.
# anthropic -> Claude (recommended when a key is available)
# gemini    -> Google Gemini
# openai    -> OpenAI
LLM_PROVIDER=none

# Only the key for the selected provider is read. If the key is missing,
# NagarNetra automatically falls back to the offline classifier and says so in
# the UI - it never fails a citizen's complaint because a model was unreachable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# --- Security ---------------------------------------------------------------
# Used to derive the at-rest encryption key for raw complaint text and to sign
# officer session tokens. CHANGE THIS before any non-demo use. Changing it makes
# previously stored raw text unreadable (the redacted copy is unaffected).
SECRET_KEY=nagarnetra-dev-secret-change-me
TOKEN_TTL_HOURS=12

# --- Geocoding --------------------------------------------------------------
# Nominatim's usage policy requires a real, identifying User-Agent and at most
# 1 request/second. Both are enforced in code. Put a contact address here.
NOMINATIM_USER_AGENT=NagarNetra/1.0 (hackathon prototype; contact: team@nagarnetra.local)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_ENABLED=true

# --- Demo -------------------------------------------------------------------
# DEMO_MODE exposes the dashboard reset button and pre-seeds a clean dataset.
# Turn it OFF for anything resembling a real deployment.
DEMO_MODE=true
ENVIRONMENT=development

# --- Local -----------------------------------------------------------------
# Leave blank to use backend/var/nagarnetra.db
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
MAX_UPLOAD_MB=8
